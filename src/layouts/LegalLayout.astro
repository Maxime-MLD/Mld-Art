---
/* =========================================================================
   LegalLayout.astro — Layout épuré pour les pages légales
   S'appuie sur Layout.astro pour tout le <head>, mais impose `noindex`
   (ces pages n'ont pas vocation à être référencées) et remplace la
   navigation complète par un simple retour à l'accueil.
   ========================================================================= */

import Layout from './Layout.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<Layout title={title} description={description} noindex>
  {/* --- En-tête minimal : logo seul, aucun menu --- */}
  <header class="border-b border-carbon/10 bg-paper">
    <div
      class="mx-auto flex h-20 max-w-[1600px] items-center px-6 md:px-10 lg:h-24 lg:px-16 xl:px-24"
    >
      <a
        href="/"
        aria-label="MLD DEV — retour à l'accueil"
        class="font-display text-lg font-extrabold tracking-tight text-carbon transition-colors duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent lg:text-xl"
      >
        MLD DEV<span class="text-accent">.</span>
      </a>
    </div>
  </header>

  <main>
    <div class="mx-auto max-w-[1600px] px-6 py-24 md:px-10 lg:px-16 lg:py-32 xl:px-24">
      {/* Mesure courte : un texte juridique se lit en colonne étroite */}
      <div class="max-w-3xl">
        {/* Titre de la page */}
        <h1
          class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.05] tracking-[-0.03em] text-carbon"
        >
          {title}
        </h1>

        {/* Contenu injecté par la page */}
        <div class="mt-16">
          <slot />
        </div>
      </div>
    </div>
  </main>

  {/* --- Pied de page minimal --- */}
  <footer class="border-t border-carbon/10">
    <div
      class="mx-auto flex max-w-[1600px] flex-col gap-4 px-6 py-8 md:flex-row md:items-center md:justify-between md:px-10 lg:px-16 xl:px-24"
    >
      <p class="font-body text-xs text-carbon/65">
        © {new Date().getFullYear()} MLD DEV. Tous droits réservés.
      </p>

      <a
        href="/"
        class="font-body text-xs text-carbon/65 transition-colors duration-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Retour à l'accueil
      </a>
    </div>
  </footer>
</Layout>
