---
/* =========================================================================
  ProjectCard.astro — Une réalisation, présentée seule (jamais en grille)
  Visuel 60 % / texte 40 %, alternance gauche-droite pilotée par `isReversed`.
  Le filet horizontal supérieur assure la séparation pleine largeur entre
  deux projets consécutifs.
   ========================================================================= */

/* `Picture` et non `Image` : il faut deux formats, AVIF avec repli WebP.
   `Image` n'en produit qu'un seul. */
import { Picture } from 'astro:assets';

interface Props {
  title: string;
  category: string;
  description: string;
  /* Optionnelle, et c'est volontaire : seule la page /realisations la
     transmet. L'accueil ne la passe pas et conserve donc exactement son
     rendu d'origine, avec la description courte et sans bouton. */
  descriptionLongue?: string[];
  imageSrc: ImageMetadata;
  imageAlt: string;
  projectUrl: string;
  isReversed?: boolean;
}

const {
  title,
  category,
  description,
  descriptionLongue,
  imageSrc,
  imageAlt,
  projectUrl,
  isReversed = false,
} = Astro.props;

const estDepliable = Array.isArray(descriptionLongue) && descriptionLongue.length > 0;

/* Identifiant stable, dérivé du titre : il relie le bouton à son texte via
   `aria-controls`. */
const idDescription = `description-${title
  .toLowerCase()
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/(^-|-$)/g, '')}`;

---

{/* `data-anim-start` retardé : au seuil courant, le projet est déjà en place
   quand l'œil l'atteint et le mouvement passe inaperçu. */}
<article data-anim-line data-anim-start="top 75%" class="filet-t">
  {/* La colonne du visuel fait toujours 60 % : quand l'ordre est inversé, on
      inverse aussi le gabarit de grille, sinon l'image passerait à 40 %. */}
  <div
    class:list={[
      'mx-auto grid max-w-[1600px] gap-10 px-6 py-16 md:px-10 md:py-20 lg:items-center lg:gap-20 lg:px-16 lg:py-28 xl:px-24',
      isReversed ? 'lg:grid-cols-[40fr_60fr]' : 'lg:grid-cols-[60fr_40fr]',
    ]}
  >
    {/* ==================================================================
        VISUEL (60 %) — toujours premier dans le DOM, donc toujours au-dessus
        du texte sur mobile, quel que soit `isReversed`.
        ================================================================== */}
    <div
      data-anim
      data-anim-start="top 70%"
      class:list={[
        'overflow-hidden border border-carbon/20',
        isReversed ? 'lg:order-2' : 'lg:order-1',
      ]}
    >
      {/* --- Capture du site livré ---
          ⚠️ Les captures doivent être prises en **1600 × 1000 px, en DPR 2**
          (soit 3200 × 2000 px réels) : ce sont des images de texte fin, pas
          des photographies, et elles doivent rester lisibles sur écran Retina.

          `aspect-[16/10]` reprend le ratio réel d'un viewport de bureau : la
          capture n'est donc pas recadrée. Si elle ne tombe pas juste,
          `object-top` la rogne par le BAS — le haut d'une page est ce qui la
          vend, le bas n'affiche que le début de la section suivante.

          `origin-top` : le micro-zoom au survol reste ancré en haut, sinon il
          fait glisser cette même partie hors du cadre.

          `quality: 90` : au réglage par défaut, le texte fin des captures
          ressort flou.

          `widths` seul, jamais couplé à `densities` : le couple
          `widths` + `sizes` laisse le navigateur choisir, DPR compris. Les
          trois paliers couvrent le 2x jusqu'à 1600px de large.

          `data-project-image` : cible du micro-zoom au survol. */}
      <Picture
        src={imageSrc}
        alt={imageAlt}
        widths={[480, 640, 800, 1200, 1600]}
        sizes="(min-width: 1600px) 800px, (min-width: 1024px) 48vw, 90vw"
        formats={['avif']}
        fallbackFormat="webp"
        quality={90}
        loading="lazy"
        data-project-image
        pictureAttributes={{ class: 'block' }}
        class="block aspect-[16/10] w-full origin-top object-cover object-top"
      />
    </div>

    {/* ==================================================================
        TEXTE (40 %)
        ================================================================== */}
    <div
      data-anim
      data-anim-start="top 70%"
      class:list={[
        'flex flex-col',
        isReversed ? 'lg:order-1' : 'lg:order-2',
      ]}
    >
      {/* Secteur d'activité — italique discret, façon cartel de musée.
          Opacité 65 % : c'est le palier le plus discret qui tienne le
          contraste AA à cette taille (5,03:1 ; 50 % tombait à 3,20:1). */}
      <p class="font-body text-sm italic text-carbon/65">{category}</p>

      {/* Titre du projet */}
      <h3 class="mt-4 font-display text-[clamp(1.75rem,2.6vw,2.5rem)] font-bold leading-[1.1] tracking-[-0.02em] text-carbon">
        {title}
      </h3>

      {
        estDepliable ? (
          /* --- Description longue, tronquée et dépliable ---
             La troncature est portée par la classe `js` du <html> : sans
             JavaScript, aucune hauteur maximale ne s'applique, le texte est
             entier et le bouton reste masqué.
             FORMULE DES HAUTEURS : max-height = nombre de lignes × interligne.
             L'interligne effectif est celui de `leading-relaxed`, soit 1,625
             (26px pour un corps de 16px) — d'où 5 × 1,625 = 8,125em au-delà
             de md, et 4 × 1,625 = 6,5em en mobile.
             Ces valeurs sont des multiples EXACTS de l'interligne : la coupe
             tombe donc sur une frontière entre deux lignes, et la dernière
             ligne reste entière, jambages compris. Recalculer si l'interligne
             change.
             Le conteneur porte les mêmes classes de texte que ses
             paragraphes : sans cela, `em` se calculerait sur les 16px hérités
             du corps de page plutôt que sur la taille réellement affichée, et
             la troncature dériverait au moindre changement de typographie.

             Le fondu n'est plus un calque superposé mais un `mask-image`
             appliqué au texte lui-même (voir global.css) : plus rien ne
             recouvre le paragraphe, donc plus aucun risque de bande de
             raccord avec le fond. */
          <div class="mt-6 max-w-md" data-desc>
            <div
              id={idDescription}
              data-desc-contenu
              class="space-y-4 overflow-hidden font-body text-base leading-relaxed [.js_&]:max-h-[6.5em] md:[.js_&]:max-h-[8.125em]"
            >
              {descriptionLongue.map((paragraphe) => (
                <p class="font-body text-base leading-relaxed text-carbon/70">
                  {paragraphe}
                </p>
              ))}
            </div>

            {/* Bouton secondaire, dans le flux, après le texte : plus aucun
                chevauchement.
                Traitement volontairement discret — c'est « Visiter le site »
                qui porte l'action principale, les deux ne doivent pas se
                concurrencer.
                Masqué sans JavaScript : il n'aurait rien à déplier. */}
            <button
              type="button"
              data-desc-bouton
              aria-expanded="false"
              aria-controls={idDescription}
              class="relative mt-4 hidden pb-1 font-body text-sm text-carbon/65 cursor-pointer transition-colors duration-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent [.js_&]:block after:absolute after:bottom-0 after:right-0 after:h-[1px] after:w-full after:origin-left after:scale-x-100 after:bg-carbon/30 after:transition-transform after:duration-300 after:ease-out hover:after:origin-right hover:after:scale-x-0"
            >
              Voir plus
            </button>
          </div>
        ) : (
          /* --- Description courte — axée design & performance --- */
          <p class="mt-6 max-w-md font-body text-base leading-relaxed text-carbon/70">
            {description}
          </p>
        )
      }

      {/* Lien de visite — filet de soulignement qui passe à l'orange au survol */}
      <div class="mt-10">
        <a
          href={projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visiter le site de ${title} (nouvelle fenêtre)`}
          class="relative inline-block font-body text-base font-medium text-carbon transition-colors duration-300 after:absolute after:inset-x-0 after:-bottom-1 after:h-px after:origin-right after:scale-x-0 after:bg-accent after:transition-transform after:duration-300 after:ease-out hover:text-accent hover:after:origin-left hover:after:scale-x-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          Visiter le site
        </a>
      </div>
    </div>
  </div>
</article>
