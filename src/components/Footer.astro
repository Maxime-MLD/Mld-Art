---
/* =========================================================================
  Footer.astro — Pied de page
  Grand espace vide au-dessus, encadré de filets fins, puis deux colonnes
  de liens, la ligne de copyright, et le watermark signature collé au bas.
   ========================================================================= */

import Watermark from './Watermark.astro';

/* --- DONNÉES : navigation interne --- */
const navLinks = [
  { label: 'Services', href: '#services' },
  { label: 'Réalisations', href: '#realisations' },
  { label: 'À Propos', href: '#manifeste' },
  { label: 'Contact', href: '#contact' },
];

/* --- DONNÉES : liens externes --- */
// TODO: URLs réelles des réseaux sociaux et de la fiche Google Maps
const socialLinks = [
  { label: 'Instagram', href: 'https://www.instagram.com/mld_developpement?utm_source=qr' },
  { label: 'Google', href: 'https://www.google.com/maps/place//data=!4m3!3m2!1s0x818e7c397bc4f969:0xab4357d73b8f262f!12e1?source=g.page.m._&laa=merchant-review-solicitation' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/maxime-lagraa-4a4299386' },
];

/* Année calculée au build : le copyright ne se périme pas tout seul. */
const currentYear = new Date().getFullYear();

const linkClasses =
  'font-body text-sm text-carbon transition-colors duration-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent';
---

{/* Aucun filet haut ici : la bordure basse de la section Contact fait déjà
    cette ligne. En porter un second donnerait un trait de 2px. */}
<footer>
  <div class="mx-auto max-w-[1600px] px-6 md:px-10 lg:px-16 xl:px-24">
    {/* ==================================================================
        GRAND ESPACE VIDE puis les deux colonnes de liens
        ================================================================== */}
    <div class="grid gap-14 pt-32 pb-24 md:grid-cols-2 lg:pt-40 lg:pb-28">
      {/* --- Colonne 1 : navigation interne, empilée verticalement --- */}
      <nav aria-label="Navigation de pied de page">
        <p class="font-body text-xs uppercase tracking-wider text-carbon/65">
          Navigation
        </p>
        <ul class="mt-8 space-y-4">
          {
            navLinks.map((link) => (
              <li>
                <a href={link.href} class={linkClasses}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      {/* --- Colonne 2 : liens externes, textuels et sans icône --- */}
      <div>
        <p class="font-body text-xs uppercase tracking-wider text-carbon/65">
          Suivre l'agence
        </p>
        <ul class="mt-8 space-y-4">
          {
            socialLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`MLD DEV sur ${link.label} (nouvelle fenêtre)`}
                  class={linkClasses}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {/* ==================================================================
        LIGNE DE COPYRIGHT puis filet
        Le filet ferme la ligne par le bas (`border-b`) au lieu de l'ouvrir
        par le haut : la mention légale appartient au bloc de contenu, et le
        watermark reste seul en dessous du trait, comme une signature au bas
        d'une toile. Disposition inchangée — copyright à gauche, mentions
        légales à droite à partir de `md`.
        ================================================================== */}
    <div
      class="flex flex-col gap-4 border-b border-carbon/10 py-8 mb-32 md:flex-row md:items-center md:justify-between"
    >
      {/* Copyright — le second « MLD DEV » renvoie vers le site */}
      <p class="font-body text-xs leading-relaxed text-carbon/65">
        © {currentYear} MLD DEV. Tous droits réservés. Site créé par{' '}
        {/* Souligné : au milieu d'un bloc de texte, un lien ne peut pas se
            distinguer par la seule couleur (critère WCAG 1.4.1). */}
        <a
          href="https://www.mld-dev.com"
          class="text-carbon underline decoration-1 underline-offset-4 transition-colors duration-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        >
          MLD DEV
        </a>
      </p>

      {/* Lien discret vers les mentions légales */}
      <a
        href="/mentions-legales"
        class="font-body text-xs text-carbon/65 transition-colors duration-300 hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Mentions Légales &amp; Confidentialité
      </a>
    </div>
  </div>

  {/* ==================================================================
      WATERMARK — hors du conteneur : il doit toucher les bords de l'écran
      ================================================================== */}
  <Watermark />
</footer>
