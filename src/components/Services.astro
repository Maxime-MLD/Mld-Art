---
/* =========================================================================
  Services.astro — « L'Atelier »
  Colonnes épurées séparées par des filets verticaux fins (cartels de musée).
  Sur mobile, les colonnes s'empilent et les filets deviennent horizontaux.
   ========================================================================= */

import ServiceCard from './ServiceCard.astro';

/* --- DONNÉES : les prestations ---
   L'accent orange alterne d'une carte à l'autre : prix, puces, prix. */
// TODO: ajuster les intitulés, les tarifs réels et le détail des prestations
const services = [
  {
    title: 'Le Site Vitrine',
    description:
      "Une page unique, rapide et percutante pour présenter votre activité, valoriser votre savoir-faire et guider vos visiteurs vers l’essentiel : vos services, vos coordonnées et une prise de contact simple.",
    price: '1000 €', // TODO: tarif réel
    ctaLabel: 'Demander mon devis',
    ctaHref: '#contact',
    offre: 'site-vitrine',
    features: [
      'Site une page, sur mesure',
      'Choix du design & couleurs',
      'Référencement (SEO) local Roanne & Loire',
      'Rédaction des textes accompagnée',
      'Formulaire de contact sécurisé',
      'Conformité RGPD et mentions légales',
    ],
    accent: 'price' as const,
  },
  {
    title: 'Le Site Vitrine Multipages',
    description:
      'Un site complet avec plusieurs pages pour présenter vos services en détail, renforcer votre référencement local à Roanne et construire une identité visuelle sur mesure, fidèle à votre métier.',
    price: '1500 €', // TODO: tarif réel
    ctaLabel: 'Demander mon devis',
    ctaHref: '#contact',
    offre: 'site-vitrine-multipages',
    features: [
      'Jusqu’à 5 pages sur-mesure',
      'Choix du design & couleurs',
      'Référencement (SEO) local Roanne & Loire',
      'Rédaction des textes accompagnée',
      'Formulaire de contact sécurisé',
      'Conformité RGPD et mentions légales',
    ],
    accent: 'features' as const,
  },
  {
    title: 'La Refonte',
    description:
      "Modernisez votre site avec un design plus actuel, une navigation claire et une expérience mobile fluide, tout en conservant vos contenus essentiels et les acquis de votre référencement.",
    price: 'sur devis', // TODO: tarif réel
    /* Prestation chiffrée au cas par cas : « TTC » n'annonce rien tant qu'il
       n'y a pas de montant. La mention est donc coupée sur cette carte. */
    showTTC: false,
    ctaLabel: 'Demander un audit gratuit',
    ctaHref: '#contact',
    offre: 'refonte',
    features: [
      'Audit technique et de performance',
      'Reprise de la structure et des contenus',
      'Choix du design & couleurs',
      'Référencement (SEO) local Roanne & Loire',
      'Ajout ou modification de section'
    ],
    accent: 'price' as const,
  },
];

/* --- DONNÉES : les offres complémentaires ---
   Deux prestations qui s'ajoutent à une formule principale, jamais vendues
   seules. L'accent y est réservé au prix : les puces restent neutres. */
// TODO: ajuster la liste des prestations incluses dans chacune
const complements = [
  {
    title: 'La Maintenance & L\'hébergement',
    description:
      "Un site hébergé, sécurisé, sauvegardé et toujours à jour. Vous bénéficiez aussi de trois interventions mensuelles d’une heure pour modifier vos textes, images ou contenus.",
    price: '40 €',
    pricePeriod: '/ mois',
    ctaLabel: 'Souscrire à la maintenance',
    ctaHref: '#contact',
    offre: 'maintenance-hebergement',
    features: [
      'Jusqu’à trois interventions par mois',
      'Une heure d’intervention par demande',
      'Modification des textes',
      'Ajout ou remplacement de photos',
      'Mises à jour techniques et sauvegardes',
    ],
    accent: 'price' as const,
  },
  {
    title: 'La Fiche Google',
    description:
      'Je crée et optimise votre fiche d’établissement Google pour renforcer votre visibilité à Roanne, présenter vos informations essentielles et faciliter la collecte d’avis clients.',
    price: '200 €',
    ctaLabel: 'Optimiser ma fiche Google',
    ctaHref: '#contact',
    offre: 'fiche-google',
    features: [
      'Création et vérification de la fiche',
      'Catégories, horaires et zone d’intervention',
      'Photos et description optimisées',
      'Lien vers le site et suivi des premiers avis',
      'Prise en main',
    ],
    accent: 'price' as const,
  },
];
---

<section id="services" data-anim-line class="filet-b">
  {/* --- En-tête de section --- */}
  <div class="mx-auto max-w-[1600px] px-6 pt-24 pb-16 md:px-10 lg:px-16 lg:pt-32 lg:pb-20 xl:px-24">
    <h2
      data-anim
      class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.05] tracking-[-0.03em] text-carbon"
    >
      L'Agence<span class="text-accent">.</span>
    </h2>
  </div>

  {/* --- Colonnes de prestations ---
      Les filets sont obtenus par une gouttière de 1px (`gap-px`) laissant
      voir le fond `carbon/10` du conteneur : les lignes restent justes à
      tous les breakpoints, sans doublon ni filet orphelin.
      1 colonne en mobile, 2 en tablette, 3 en desktop.
      Aucune carte n'a de traitement particulier : les colonnes ont toutes la
      même largeur, et celle qui reste seule sur la dernière ligne en tablette
      garde la largeur de sa colonne, alignée à gauche. Deux réglages s'en
      chargent :
      • `grid-cols-1 md:grid-cols-2 lg:grid-cols-3` pose des pistes en
        `minmax(0, 1fr)`, donc de largeur imposée. Des pistes en `auto` se
        seraient élargies au contenu — c'est exactement ce qui déformait la
        dernière ligne ;
      • `justify-items-start` empêche la carte orpheline de s'étendre sur la
        ligne. Les cartes n'en remplissent pas moins leur colonne : leur
        largeur au contenu est plafonnée à la piste, et un paragraphe suffit à
        l'atteindre. */}
  <div data-anim-line class="filet-t">
    <div
      class="mx-auto grid max-w-[1600px] grid-cols-1 justify-items-start gap-px bg-carbon/10 md:grid-cols-2 lg:grid-cols-3"
    >
      {
        services.map((service) => (
          <ServiceCard
            title={service.title}
            description={service.description}
            price={service.price}
            showTTC={service.showTTC}
            features={service.features}
            ctaLabel={service.ctaLabel}
            ctaHref={service.ctaHref}
            offre={service.offre}
            accent={service.accent}
          />
        ))
      }

      {/* Cale de fin de grille — nombre impair de cartes.
          Le fond `carbon/10` du conteneur, qui dessine les filets dans les
          gouttières, transparaît aussi dans la case laissée libre par la
          dernière ligne en tablette : un aplat gris pleine hauteur à côté de
          la carte. Cette cale le recouvre de papier, sans rien changer à la
          carte, qui garde la largeur de sa colonne et son alignement à
          gauche. `w-full` est nécessaire : sous `justify-items-start`, un
          élément vide se réduirait à une largeur nulle et découvrirait de
          nouveau l'aplat. Purement décorative, donc masquée aux lecteurs
          d'écran, et inutile en desktop où les trois colonnes sont pleines. */}
      {services.length % 2 === 1 && (
        <div aria-hidden="true" class="hidden w-full bg-paper md:block lg:hidden"></div>
      )}
    </div>
  </div>

  {/* --- Offres complémentaires ---
      `filet-t` : le filet pleine largeur qui sépare cette rangée de celle des
      trois offres principales. */}
  <div data-anim-line class="filet-t">
    {/* Sous-titre discret, nettement plus petit que les H2 de section */}
    <div class="mx-auto max-w-[1600px] px-6 pt-16 pb-10 md:px-10 lg:px-16 lg:pt-20 lg:pb-12 xl:px-24">
      <h3
        data-anim
        class="font-display text-[clamp(1.25rem,2vw,1.75rem)] font-bold leading-tight tracking-[-0.02em] text-carbon"
      >
        En complément<span class="text-accent">.</span>
      </h3>
    </div>

    {/* Même technique de filets que la rangée du dessus : la gouttière de 1px
        laisse voir le fond `carbon/10`. Verticale à partir de md, horizontale
        en dessous, sans réglage supplémentaire.
        À partir de lg, la paire est ramenée aux deux tiers de la largeur et
        centrée : chaque carte retrouve ainsi la largeur exacte des trois
        cartes du dessus, au lieu de s'étirer sur toute la section.
        `w-2/3` suit la largeur d'écran, `max-w-[1066px]` la borne aux deux
        tiers du conteneur une fois celui-ci plafonné à 1600px. */}
    <div class="mx-auto grid max-w-[1600px] gap-px bg-carbon/10 md:grid-cols-2 lg:w-2/3 lg:max-w-[1066px]">
      {
        complements.map((complement) => (
          <ServiceCard
            title={complement.title}
            description={complement.description}
            price={complement.price}
            pricePeriod={complement.pricePeriod}
            features={complement.features}
            ctaLabel={complement.ctaLabel}
            ctaHref={complement.ctaHref}
            offre={complement.offre}
            accent={complement.accent}
          />
        ))
      }
    </div>
  </div>
</section>
