---
/* =========================================================================
  Realisations.astro — Portfolio
  Les projets sont présentés un par un, en alternance gauche/droite.
   ========================================================================= */

import ProjectCard from './ProjectCard.astro';
import { projets } from '../data/projets';

/* L'accueil ne montre que les trois premiers projets : la page /realisations
   affiche le catalogue complet. */
const projectsAffiches = projets.slice(0, 3);
---

<section id="realisations" data-anim-line class="filet-b">
  {/* --- En-tête de section --- */}
  <div class="mx-auto max-w-[1600px] px-6 pt-24 pb-16 md:px-10 lg:px-16 lg:pt-32 lg:pb-20 xl:px-24">
    <h2
      data-anim
      class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.05] tracking-[-0.03em] text-carbon"
    >
      Mes Réalisations<span class="text-accent">.</span>
    </h2>
  </div>

  {/* --- Liste des projets ---
      Chaque carte porte son filet horizontal supérieur : la séparation entre
      deux projets est donc pleine largeur. */}
  {
    projectsAffiches.map((project, index) => (
      <ProjectCard
        title={project.title}
        category={project.category}
        description={project.description}
        imageSrc={project.imageSrc}
        imageAlt={project.imageAlt}
        projectUrl={project.projectUrl}
        isReversed={index % 2 === 1}
      />
    ))
  }

  {/* --- Accès au catalogue complet ---
      Placé après le dernier projet, avant le filet de fin de section. */}
  <div class="mx-auto max-w-[1600px] px-6 py-24 md:px-10 lg:px-16 lg:py-32 xl:px-24">
    <div data-anim class="flex justify-center">
      <a
        href="/realisations"
        class="inline-block rounded-none border border-carbon px-8 py-4 font-body text-xs font-medium uppercase tracking-wider text-carbon transition-colors duration-300 hover:bg-carbon hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        Voir toutes les réalisations
      </a>
    </div>
  </div>
</section>
