---
/* =========================================================================
   Critiques.astro — Avis clients
   Bandeau défilant en continu (marquee) : la liste est dupliquée une fois
   dans le DOM et la piste est déplacée en `translateX` par GSAP.
   Aucun conteneur à défilement natif ici : c'est ce qui capturait la molette
   et empêchait la page de défiler quand le curseur passait sur la zone.
   Aucun avatar, aucune ombre portée, aucun arrondi.
   ========================================================================= */

/* --- DONNÉES : les avis --- */
// TODO: remplacer par les avis réels (Google Business), avec accord des clients
const reviews = [
  {
    rating: 5,
    quote:
      'Maxime a compris mon métier avant de parler design. Le site est moderne, rapide et magnifique, je reçois enfin des demandes de devis par le formulaire.',
    author: 'Denis.G.',
    activity: 'Métallier — Vougy',
  },
  {
    rating: 5,
    quote:
      "Trois semaines entre le premier échange et la mise en ligne. Aucun jargon, des réponses claires, et un résultat très au-dessus de ce que j'imaginais. J'adore.",
    author: 'Claire.B.',
    activity: 'Salon de coiffure — Roanne',
  },
  {
    rating: 5,
    quote:
      'Notre ancien site mettait huit secondes à s’afficher. Le nouveau est instantané et un designe moderne. Nous sommes remontés dans les recherches Google.',
    author: 'Laurent.F.',
    activity: 'Cabinet dentaire — Le Coteau',
  },
  {
    rating: 5,
    quote:
      "Ce qui m'a marqué, c'est le soin apporté aux détails : les espacements, les photos recadrées, les textes retravaillés. Le site nous ressemble. Je recommande MLD DEV.",
    author: 'Sophie.R.',
    activity: 'Fleuriste — Riorges',
  },
  {
    rating: 4,
    quote:
      'Un interlocuteur unique du début à la fin, joignable, qui explique ce qu’il fait et pourquoi. Le devis annoncé a été le devis payé. Je recommande.',
    author: 'Julien.P.',
    activity: 'Paysagiste — Mably',
  },
  {
    rating: 5,
    quote:
      'Nous étions invisibles sur Google en dehors de notre nom. Six mois après la mise en ligne, nous sortons sur nos deux principales prestations. Merci Mld Dev.',
    author: 'Nathalie.C.',
    activity: 'Institut de beauté — Roanne',
  },
];

/* Chemin de l'étoile, isolé pour ne pas le répéter six fois par carte */
const CHEMIN_ETOILE =
  'M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 7.1-1.01L12 2z';
---

<section id="critiques" data-anim-line class="filet-b">
  {/* ==================================================================
      BANDEAU DE TITRE — pleine largeur, fermé par son propre filet.
      Le filet du dessus est la bordure basse de la section précédente :
      aucune section ne porte de `border-t`, sinon les traits doubleraient.
      ================================================================== */}
  <div data-anim-line class="filet-b">
    <div class="mx-auto max-w-[1600px] px-6 pt-24 pb-16 md:px-10 lg:px-16 lg:pt-32 lg:pb-20 xl:px-24">
      <h2
        data-anim
        class="font-display text-[clamp(2rem,4.5vw,3.5rem)] font-bold leading-[1.05] tracking-[-0.03em] text-carbon"
      >
        Les Critiques<span class="text-accent">.</span>
      </h2>
    </div>
  </div>

  {/* ==================================================================
      BANDEAU DÉFILANT
      `overflow-hidden` seul : aucune zone scrollable, donc la molette
      continue de faire défiler la page normalement.
      En « animations réduites », le bandeau se replie en grille statique
      (variantes `motion-reduce:`) et la copie est retirée du flux.
      ================================================================== */}
  <div
    id="critiques-marquee"
    class="overflow-hidden py-24 lg:py-32 motion-reduce:px-6 motion-reduce:md:px-10 motion-reduce:lg:px-16 motion-reduce:xl:px-24"
  >
    <div
      id="critiques-track"
      class="flex w-max motion-reduce:w-full motion-reduce:flex-wrap motion-reduce:justify-center"
    >
      {/* --- Liste visible --- */}
      <div class="flex motion-reduce:flex-wrap motion-reduce:justify-center motion-reduce:gap-y-12">
        {
          reviews.map((review) => (
            <figure class="flex w-[300px] shrink-0 flex-col border-l border-carbon/10 px-8 lg:w-[380px]">
              {/* 1. Note — étoiles décoratives, l'information est portée par
                     le libellé accessible du groupe */}
              <div
                role="img"
                aria-label={`Note : ${review.rating} étoiles sur 5`}
                class="flex items-center gap-1 text-accent"
              >
                {
                  Array.from({ length: review.rating }).map(() => (
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      class="h-3.5 w-3.5"
                    >
                      <path d={CHEMIN_ETOILE} />
                    </svg>
                  ))
                }
              </div>

              {/* 2. Citation */}
              <blockquote class="mt-6 font-body text-base leading-relaxed text-carbon">
                {review.quote}
              </blockquote>

              {/* 3. Filet court en accent — respiration généreuse de part et
                     d'autre, il sépare la parole du client de sa signature */}
              <div aria-hidden="true" class="my-10 h-px w-10 bg-accent"></div>

              {/* 4 & 5. Signature : nom, puis activité et ville */}
              <figcaption class="mt-auto">
                <p class="font-display text-sm font-semibold text-carbon">
                  {review.author}
                </p>
                {/* Opacité 65 % : palier minimal tenant le contraste AA à 12px
                    (60 % tombe à 4,31:1, sous le seuil de 4,5:1) */}
                <p class="mt-2 font-body text-xs uppercase tracking-wider text-carbon/65">
                  {review.activity}
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>

      {/* --- Copie pour la boucle sans raccord ---
          Strictement identique à la liste visible : les deux moitiés de la
          piste étant égales, un déplacement de -50 % boucle sans saut.
          Retirée de l'arbre d'accessibilité et du flux si les animations
          sont désactivées. */}
      <div aria-hidden="true" class="flex motion-reduce:hidden">
        {
          reviews.map((review) => (
            <figure class="flex w-[300px] shrink-0 flex-col border-l border-carbon/10 px-8 lg:w-[380px]">
              <div class="flex items-center gap-1 text-accent">
                {
                  Array.from({ length: review.rating }).map(() => (
                    <svg viewBox="0 0 24 24" fill="currentColor" class="h-3.5 w-3.5">
                      <path d={CHEMIN_ETOILE} />
                    </svg>
                  ))
                }
              </div>
              <blockquote class="mt-6 font-body text-base leading-relaxed text-carbon">
                {review.quote}
              </blockquote>
              <div class="my-10 h-px w-10 bg-accent"></div>
              <figcaption class="mt-auto">
                <p class="font-display text-sm font-semibold text-carbon">
                  {review.author}
                </p>
                <p class="mt-2 font-body text-xs uppercase tracking-wider text-carbon/65">
                  {review.activity}
                </p>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>
